{
  "compilerOptions": {
    // ---------- File layout ----------
    "rootDir": "./src",                      // Your source code lives in src/, so compiled output mirrors that structure
    "outDir": "./dist",                      // `tsc` writes compiled .js files here instead of next to your .ts files

    // ---------- Environment ----------
    "module": "commonjs",                    // Compile import/export to require/module.exports (matches Node's default with no "type" in package.json)
    "target": "es2022",                      // Output modern JS; Node 20 supports it natively (async/await, classes, etc.)
    "types": ["node"],                       // Only auto-load Node's global types (process, Buffer...); needs `npm i -D @types/node`
    "esModuleInterop": true,                 // Lets `import express from "express"` work with CommonJS packages

    // ---------- Outputs ----------
    "sourceMap": true,                       // Generates .map files so error stack traces point to your .ts lines

    // ---------- Type checking ----------
    "strict": true,                          // Turns on all strict checks (null checks, no implicit any, etc.)
    "noUncheckedIndexedAccess": true,        // arr[0] and obj[key] are typed `T | undefined`, forcing you to handle missing values

    // ---------- Compatibility / safety ----------
    "isolatedModules": true,                 // Ensures each file can be compiled alone, which is how tsx/esbuild work
    "verbatimModuleSyntax": false,           // Don't force `import type` everywhere (keeps imports simpler for now)
    "noUncheckedSideEffectImports": true,    // Errors if a side-effect import like `import "dotenv/config"` can't be resolved
    "moduleDetection": "force",              // Treats every file as a module, avoiding accidental global-scope variable clashes
    "skipLibCheck": true                     // Skips type-checking inside node_modules .d.ts files (faster, fewer false errors)
  },

  "include": ["src"]                         // Only compile/check files inside src/
}